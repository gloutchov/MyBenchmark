{
  "version": 1,
  "ollama": {
    "url": "http://127.0.0.1:11434"
  },
  "pi": {
    "command": ["pi"]
  },
  "models": "installed",
  "defaults": {
    "timeout_seconds": 1200,
    "repetitions": 1,
    "thinking": "off",
    "warmup": true,
    "keep_alive": "15m",
    "context_window": 32768,
    "max_tokens": 8192,
    "temperature": 0,
    "sandbox": "audit"
  },
  "dashboard": {
    "assets_directory": "dashboard",
    "results_directory": "results",
    "snapshot_source": "cases/results_dashboard/fixture/dashboard-data.json",
    "host": "127.0.0.1",
    "port": 0,
    "open_browser": true
  },
  "profiles": {
    "smoke": ["targeted_patch"],
    "standard": ["targeted_patch", "secure_workspace", "config_i18n"],
    "full": ["targeted_patch", "secure_workspace", "config_i18n", "milestone_closure"],
    "showcase": ["results_dashboard"]
  },
  "cases": {
    "directory": "cases"
  }
}
